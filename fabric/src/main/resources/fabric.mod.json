{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/kingnhcomcast/cinderstride",
        "sources": "https://github.com/kingnhcomcast/cinderstride"
    },
    "license": "${license}",
    "icon": "assets/cinderstride/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.drahlek.cinderstride.CinderStride"
        ],
        "client": [
            "io.drahlek.cinderstride.CinderStrideClient"
        ]
    },
    "mixins": [
        {
            "config": "cinderstride.common.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "cinderstride.fabric.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "cinderstride.fabric.mixins.json"
        },
        {
            "config": "cinderstride.common.main.mixins.json"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "dirigo": "${dirigo_fabric_version_range}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
    }
}
  
